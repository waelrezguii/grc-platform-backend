    <!--
        ══════════════════════════════════════════════════════════════════
        SWAGGER-UI / DOMPurify CVEs
        Justification: DOMPurify is a JavaScript browser sanitization library
        bundled inside swagger-ui for rendering HTML in the browser UI.
        The Java backend never executes this JS code. Not applicable.
        ══════════════════════════════════════════════════════════════════
    -->
    <suppress>
        <notes>DOMPurify JS library inside swagger-ui JAR — not executed by the Java backend.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2025-15599</cve>
    </suppress>
    <suppress>
        <notes>DOMPurify JS library inside swagger-ui JAR — not executed by the Java backend.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2026-0540</cve>
    </suppress>
    <suppress>
        <notes>DOMPurify JS library inside swagger-ui JAR — not executed by the Java backend.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2026-41238</cve>
    </suppress>
    <suppress>
        <notes>DOMPurify JS library inside swagger-ui JAR — not executed by the Java backend.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2026-41239</cve>
    </suppress>
    <suppress>
        <notes>DOMPurify JS library inside swagger-ui JAR — not executed by the Java backend.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2026-41240</cve>
    </suppress>

